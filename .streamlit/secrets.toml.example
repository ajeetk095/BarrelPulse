# Copy into Streamlit Community Cloud -> App settings -> Secrets (never commit real keys).
# All optional: the app runs without any key using FRED's public CSV endpoint and Yahoo Finance.
FRED_API_KEY = ""   # https://fred.stlouisfed.org/docs/api/api_key.html  (higher rate limits)
EIA_API_KEY  = ""   # https://www.eia.gov/opendata/  (daily WTI spot as first choice for the live tape)

# Contact form (Developer page) — sends mail via Gmail SMTP from inside the app.
# Create a Google App Password (Account -> Security -> 2-Step Verification -> App passwords); never use your real password.
GMAIL_USER = ""          # the Gmail address that sends the mail
GMAIL_APP_PASSWORD = ""  # 16-character app password
# CONTACT_TO = ""        # optional; defaults to the developer's address
